# Frontend environment template — copy to .env.local (gitignored).
# No host string is ever hardcoded in code; everything loads from here.

# Express backend base URL, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project for Realtime channels (browser).
# PUBLIC anon key ONLY — the service_role key must never ship to the client.
# Realtime needs ALL THREE of: these two vars here, plus
# SUPABASE_JWT_SECRET in backend/.env — that secret lets the backend mint
# the per-table `realtime_token` the RLS policies scope on (without it the
# browser holds only the anon key, the policies match no rows, and the app
# silently runs REST + polling — by design, never leaking other tables).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Offline demo fallback. When the API is unreachable the UI can fall back to a
# seeded in-browser store so the prototype runs with no server at all.
# DEFAULT: ON in `next dev`, OFF in a production build. Leave it empty in
# production — a deployment whose NEXT_PUBLIC_API_URL is wrong must fail
# loudly, not quietly render seeded demo dishes as if they were real orders.
# Set to `true` only for a deliberate backend-less public demo.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=

# Used ONLY by the development-only offline login route
# (app/api/v1/auth/kds-login), which refuses to serve in a production build.
# Real kitchen auth is E2 on the backend; keep the two values identical.
# Unset defaults to 1234 so a fresh clone still opens the board.
STAFF_PIN=1234
