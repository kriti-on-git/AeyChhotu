# AeyChhotu! backend — copy to .env and fill in. Never commit .env.

# Port the API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Exact origin of the Next.js client allowed by CORS (no trailing slash).
CLIENT_URL=http://localhost:3000

# Postgres connection string (Supabase → Project Settings → Database → Connection string "URI").
# REQUIRED: the server refuses to boot if this variable is missing.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/aeychhotu

# Kitchen shift PIN (4-6 digits) checked by POST /api/v1/auth/kds-login.
STAFF_PIN=1234

# HMAC secret that signs the KDS bearer tokens (any long random string).
KDS_TOKEN_SECRET=change-me-to-a-long-random-string

# Supabase JWT secret (Supabase dashboard → Project Settings → API).
# OPTIONAL for REST, REQUIRED for Realtime after the RLS scoping fix:
# when set, E1 (diner) and E2 (staff) also issue the `realtime_token`
# whose claims the SELECT policies in sql/001_init.sql match on.
# Leave empty → realtime_token is null and the app runs REST-only.
SUPABASE_JWT_SECRET=
